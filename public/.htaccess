DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?rota=$1 [QSA,L]
</IfModule>

# So o front controller pode ser executado como PHP
<IfModule mod_authz_core.c>
    <FilesMatch "^(?!index\.php$).*\.(php|phtml|phar|ini|log|sql|env|bak|sh|json)$">
        Require all denied
    </FilesMatch>
</IfModule>
