# Credenciais e dados sensiveis
/config/.env
/config/*.local.php
/storage/logs/*
!/storage/logs/.gitkeep
/storage/backups/*
!/storage/backups/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/public/uploads/*
!/public/uploads/.htaccess
!.gitkeep

# Sistema operacional / editores
Thumbs.db
.DS_Store
*.tmp
*.bak
*.swp
