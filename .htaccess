# sisAssembleiaDeus — ambiente local (XAMPP)
# Todas as requisicoes entram por public/index.php.
DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /sisAssembleiaDeus/

    # Nega acesso HTTP direto a diretorios internos
    RewriteRule ^(config|app|database|routes|storage|docs)(/|$) - [F,L]

    # Nega arquivos sensiveis na raiz
    RewriteRule ^(\.env|\.env\.[a-zA-Z0-9_-]+|\.gitignore|composer\.(json|lock))$ - [F,L]

    # assets/ e uploads/ fisicamente estao em public/, mas sao servidos na raiz
    RewriteRule ^(assets|uploads)/(.*)$ public/$1/$2 [L]

    # Demais requisicoes -> front controller
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ public/index.php?rota=$1 [QSA,L]
</IfModule>

<IfModule !mod_rewrite.c>
    ErrorDocument 404 /sisAssembleiaDeus/index.php
</IfModule>
